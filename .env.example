# ON-PREMISE CRYPTOGRAPHIC LICENSE VALIDATION
ON_PREMISE_LICENSE_KEY="MINHAJ-ENT-2026-X992-LIVE"
LICENSE_PUBLIC_KEY="MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA..."

# POSTGRESQL DATABASE CONFIGURATION
DATABASE_URL="postgres://minhaj_admin:ChangeMeSecurely2026!@localhost:5432/minhaj_erp_db"
POSTGRES_DB="minhaj_erp_db"
POSTGRES_USER="minhaj_admin"
